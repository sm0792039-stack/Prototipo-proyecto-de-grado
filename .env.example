# Prueba local: SQLite, archivo instance/my_remember.db.
DATABASE_URL=sqlite:///my_remember.db
TIMEZONE=America/Bogota
COOKIE_SECURE=0
# SECRET_KEY: genera una clave para un despliegue con varios procesos:
# python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=coloca-aqui-tu-clave-privada

# Para conservar una instalación MySQL anterior, elimina DATABASE_URL y usa:
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=my_remember_db
# DB_USER=my_remember
# DB_PASSWORD=coloca-aqui-tu-clave
# En un servidor servido por HTTPS: COOKIE_SECURE=1
